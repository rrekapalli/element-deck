# Element Deck deploy secrets. Copy to `.env` (gitignored) at the repo root.
# Used by deploy.sh / deploy.ps1 and the Proxmox helpers. Not baked into the app.

# --- PWA host (Tailscale MagicDNS on LXC 7018) ---
ELEMENT_DECK_HOST=elementdeck.tailce422e.ts.net
# Public HTTPS so phones and tablets do not need Tailscale installed.
ELEMENT_DECK_PUBLIC_VIA_FUNNEL=true

# --- Proxmox (remote SSH when pct is not local) ---
PROXMOX_HOST=192.168.29.231
PROXMOX_USER=root
PROXMOX_PASSWORD=

# --- LXC login (user raja is created on the clone) ---
CONTAINER_USER=raja
CONTAINER_PASSWORD=

# --- Tailscale ---
# Auth key: https://login.tailscale.com/admin/settings/keys (tskey-auth-...)
TS_AUTHKEY=
TAILNET_DNS=tailce422e.ts.net
# Admin API token, used to drop a stale MagicDNS name before rejoin (tskey-api-...).
TAILSCALE_API_KEY=
