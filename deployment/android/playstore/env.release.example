# Play release settings. Copy to `.env.release` in this folder (gitignored).
# The AAB build does not require this file. The upload script reads it.

# Play Console → Setup → API access → service account JSON.
# PLAY_SERVICE_ACCOUNT_JSON=C:\secrets\play-element-deck.json

# internal | alpha | beta | production
PLAY_TRACK=internal

# In-app product ids (already queried by the client):
#   element-deck
#   classroom
# Create both as one-time products in Play Console before a purchase test.

# Fill these in Play Console before production. Internal testing can start without them.
# PRIVACY_POLICY_URL=
# TERMS_OF_SERVICE_URL=
